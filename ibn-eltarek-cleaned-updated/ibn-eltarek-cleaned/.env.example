# Copy to .env.local for local development. Configure these values in your hosting provider too.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Optional: use only if your Firestore database has a non-default ID.
VITE_FIREBASE_DATABASE_ID=
# Optional Functions Emulator function URL, including the /api function name.
# Example: http://127.0.0.1:5001/YOUR_FIREBASE_PROJECT_ID/europe-west1/api
VITE_FUNCTIONS_EMULATOR_URL=
